# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do
  desc "Description of what the lane does"
  lane :custom_lane do
    # add actions here: https://docs.fastlane.tools/actions
  end

  lane :archive do |options|

    # 使用 project_config_info action 加载配置文件
    config_info = project_config_info
    git_info_result = git_info

    # 根据 configuration_export_method 设置 configuration 和 export_method
    case options[:configuration_export_method]
    when "debug_development"
      lane_context[:configuration] = "Debug"
      lane_context[:export_method] = "development"
    when "debug_ad_hoc"
      lane_context[:configuration] = "Debug"
      lane_context[:export_method] = "ad-hoc"
    when "release_ad_hoc"
      lane_context[:configuration] = "Release"
      lane_context[:export_method] = "ad-hoc"
    when "apple_store"
      lane_context[:configuration] = "Release"
      lane_context[:export_method] = "apple-store"
    else
      lane_context[:configuration] = "Debug"
      lane_context[:export_method] = "development"
    end
    
    lane_context[:feishu_robot_webhook_url] = options[:feishu_robot_webhook_url] || config_info[:feishu_robot_webhook_url]
    lane_context[:PGY_API_KEY] = options[:PGY_API_KEY] || config_info[:PGY_API_KEY]
    lane_context[:branch_or_tag] = options[:branch_or_tag] || git_info_result[:current_branch_or_tag]

    # 使用 xcodeproj_info action 动态获取项目信息
    project_info = xcodeproj_info(
      project_path: ".",
    )

    # 从获取的信息中提取 workspace 和 scheme
    workspace = project_info[:workspace_path]
    scheme = project_info[:default_scheme]

    UI.message("Using workspace: #{workspace}")
    UI.message("Using scheme: #{scheme}")
    UI.message("PGY API Key loaded: #{lane_context[:PGY_API_KEY]}")
    # next
    gym(
      workspace: workspace,
      scheme: scheme,
      clean: true,
      configuration: lane_context[:configuration],
      export_method: lane_context[:export_method],
      include_bitcode: false,
      include_symbols: true,
      # 允许访问钥匙串 已验证
      export_xcargs: "-allowProvisioningUpdates",
      xcargs: "DEBUG_INFORMATION_FORMAT='dwarf-with-dsym'",
      #隐藏所有不必要的信息 已验证
      silent: true,
      archive_path: "./build/",
      output_directory: "./build/packages/#{lane_context[:configuration]}-#{lane_context[:export_method]}/",
      output_name: "#{scheme}.ipa",
      xcodebuild_formatter: "xcbeautify --quieter",
      disable_xcpretty: true,  # 禁用 xcpretty（类似 xcbeautify）
      suppress_xcode_output: false, # 确保原始 xcodebuild 日志可见
      #指定描述文件 也可用match 已验证
      #export_options: export_options
    )
    
    case options[:configuration_export_method]
    when "apple_store"
      deliver_ipa_to_apple_store
    else
      pgy_upload_lane
    end
  end

  lane :deliver_ipa_to_apple_store do |options|
    package_file_path = lane_context[:IPA_OUTPUT_PATH]
    config_info = project_config_info
    # 使用 xcodeproj_info action 动态获取项目信息
    project_info = xcodeproj_info(
      project_path: ".",
    )
    # 从获取的信息中提取 workspace 和 scheme
    bundle_identifier = project_info[:bundle_identifier]
    deliver(
      api_key: lane_context[:api_key],
      ipa: lane_context[:IPA_OUTPUT_PATH],
      username: config_info[:username],
      team_id: config_info[:team_id],
      team_name: config_info[:team_name],
      app_identifier: bundle_identifier,
      automatic_release: false, # 不自动发布
      force: true, # 跳过HTML报告验证
      skip_metadata: true, # 跳过元数据更新
      skip_screenshots: true, # 跳过截图更新
      phased_release: true, # 启用分阶段发布
      run_precheck_before_submit: false, # 不运行提交前检查
      precheck_include_in_app_purchases: false, # 不检查内购
      reject_if_possible: true, # 如果可能则拒绝之前的构建
      submit_for_review: false, # 不自动提交审核
      submission_information: { # Extra information for the submission (e.g. compliance specifications, IDFA settings)
        # 前缀content_rights => 问你是否包含，显示，访问第三方内容(这项我没在我提交过程中找到)，没有特殊情况也都选false就可以
        content_rights_contains_third_party_content: "false",
        content_rights_has_rights: "false",
        # 前缀add_id_info idfa相关
        add_id_info_limits_tracking: true, # 不限制跟踪（因为本来就不跟踪）
        add_id_info_serves_ads: false, # 不在App内投放广告
        add_id_info_tracks_action: true, # 不跟踪来自广告的操作
        add_id_info_tracks_install: true, # 不跟踪来自特定广告的安装
        add_id_info_uses_idfa: true, # 不使用广告标识符
      },
    )
  end

  lane :pgy_upload_lane do
    # 使用 project_config_info action 加载配置文件
    config_info = project_config_info

    package_file_path = lane_context[:IPA_OUTPUT_PATH]
    
    git_info_result = git_info
    buildUpdateDescription = "#{lane_context[:branch_or_tag]}-#{git_info_result[:last_commit_message]}-#{git_info_result[:last_commit_hash]}"

    pgy_upload(
      _api_key: lane_context[:PGY_API_KEY],
      package_file_path: package_file_path,
      buildType: "#{lane_context[:PLATFORM_NAME]}",
      buildInstallType: "1",
      buildUpdateDescription: buildUpdateDescription,
    )
    build_key = Fastlane::Actions::PgyUploadAction.return_value
    UI.success(build_key)

    # 创建 options 哈希来传递参数
    options = { build_key: build_key }
    pgy_query_upload_status(options)
  end

  lane :pgy_query_upload_status do |options|
    # 使用 project_config_info action 加载配置文件
    config_info = project_config_info

    try_count = options[:try_count] || 0
    if try_count == 10
      UI.user_error!("查询失败-次数#{try_count}")
      next
    end
    build_key = options[:build_key]
    pgy_query(
      _api_key: lane_context[:PGY_API_KEY],
      build_key: build_key,
    )
    get_build_info_command_result_json = Fastlane::Actions::PgyQueryAction.return_value
    puts "get_build_info_command_result_json"
    puts get_build_info_command_result_json

    code = get_build_info_command_result_json["code"]

    if code != 0
      cur_try_count = try_count + 1
      puts cur_try_count
      sleep(10)
      puts "10秒后查询"
      options[:try_count] = cur_try_count
      pgy_query_upload_status(options)
      next
    end

    data = get_build_info_command_result_json["data"]
    buildKey = data["buildKey"]

    package_download_url = "https://www.pgyer.com/#{buildKey}"
    puts "package_download_url"
    puts package_download_url

    git_info_result = git_info
    buildUpdateDescription = "#{lane_context[:branch_or_tag]}-#{git_info_result[:last_commit_hash]}-#{git_info_result[:last_commit_message]}"
    
    # 发送飞书机器人通知
    feishu_robot_notification(
      feishu_robot_webhook_url: lane_context[:feishu_robot_webhook_url],
      display_name: lane_context[:XCODEPROJ_DISPLAY_NAME] || lane_context[:XCODEPROJ_DEFAULT_SCHEME],
      current_branch_or_tag: lane_context[:branch_or_tag],
      last_commit_message: git_info_result[:last_commit_message],
      last_commit_hash: git_info_result[:last_commit_hash],
      configuration: lane_context[:configuration] || "Debug",
      export_method: lane_context[:export_method] || "development",
      package_download_url: package_download_url
    )
  end


  lane :apple_store_connect_init do |options|

    config_info = project_config_info
    UI.message("key_id Key loaded: #{config_info[:key_id]}")
    UI.message("issuer_id Key loaded: #{config_info[:issuer_id]}")

    api_key = app_store_connect_api_key(
      key_id: config_info[:key_id],
      issuer_id: config_info[:issuer_id],
      key_filepath: "./fastlane/AuthKey_493GC2HRH5.p8",
      duration: 1200, # optional (maximum 1200)
      in_house: false, # optional but may be required if using match/sigh
    )
    lane_context[:api_key] = api_key

    puts "api_key: "
    puts api_key
  end

  lane :update_devices do |options|

    devices_file = options[:devices_file] || "./fastlane/devices.txt"

    apple_store_connect_init

    config_info = project_config_info
    UI.message("username Key loaded: #{config_info[:username]}")
    UI.message("team_id Key loaded: #{config_info[:team_id]}")
    UI.message("team_name Key loaded: #{config_info[:team_name]}")

    register_devices(
      api_key: lane_context[:api_key],
      username: config_info[:username],
      team_id: config_info[:team_id],
      team_name: config_info[:team_name],
      devices_file: devices_file,
    )


    update_profiles(get_api_key: false)
  end

  lane :update_profiles do |options|

    eval_apple_store_connect_init = options[:get_api_key] || true

    if eval_apple_store_connect_init
      apple_store_connect_init
    end
    
    config_info = project_config_info
    UI.message("username Key loaded: #{config_info[:username]}")
    UI.message("team_id Key loaded: #{config_info[:team_id]}")
    UI.message("team_name Key loaded: #{config_info[:team_name]}")
    UI.message("team_name Key loaded: #{config_info[:team_name]}")

    # 使用 xcodeproj_info action 动态获取项目信息
    project_info = xcodeproj_info(
      project_path: ".",
    )
    # 从获取的信息中提取 workspace 和 scheme
    bundle_identifier = project_info[:bundle_identifier]
    UI.message("bundle_identifier: #{bundle_identifier}")

    cur_filename = bundle_identifier + ".mobileprovision"

    cur_time = Time.new
    profiles_dir_path = "./fastlane/profiles/#{cur_time.strftime("%Y-%m-%d-%H-%M-%S")}"

    get_provisioning_profile(
      api_key: lane_context[:api_key],
      username: config_info[:username],
      team_id: config_info[:team_id],
      team_name: config_info[:team_name],
      app_identifier: bundle_identifier,
      development: true,
      force: true,
      filename: cur_filename,
      output_path: profiles_dir_path
    )
    
    cur_profile_path = "#{profiles_dir_path}/#{cur_filename}"
    puts "cur_profile_path:"
    puts cur_profile_path
    install_provisioning_profile(path: cur_profile_path)

  end
  
  # 测试飞书机器人通知的lane
  lane :test_feishu_notification do |options|
    configuration = options[:configuration] || "Debug"
    export_method = options[:export_method] || "development"
    package_download_url = options[:package_download_url] || "https://example.com/test.ipa"
    
    UI.message("测试飞书机器人通知...")
    
    # 获取项目信息
    project_info = xcodeproj_info(
      project_path: ".",
    )
    
    project_name = project_info[:display_name] || project_info[:default_scheme]
    UI.message("项目名称: #{project_name}")
    UI.message("配置: #{configuration}")
    UI.message("导出方式: #{export_method}")
    UI.message("下载地址: #{package_download_url}")
    
    feishu_robot_notification(
      project_name: project_name,
      configuration: configuration,
      export_method: export_method,
      package_download_url: package_download_url
    )
    
    UI.success("飞书机器人通知测试完成！")
  end
  
end
